<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- Declared by androidx.media3:media3-common; the app has no network code. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <!-- Declared by androidx.media3:media3-exoplayer; the app holds no wake
         lock (the video surface keeps the screen on while playing). -->
    <uses-permission
        android:name="android.permission.WAKE_LOCK"
        tools:node="remove" />

    <application
        android:name=".PvApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- The lock screen is the only exported activity in the benchmark
             and release variants (docs/PHASE3A_DESIGN.md Section 5, D-019). -->
        <activity
            android:name=".LockActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".GalleryActivity"
            android:exported="false" />

        <activity
            android:name=".ViewerActivity"
            android:exported="false" />

        <activity
            android:name=".VideoActivity"
            android:exported="false" />

        <activity
            android:name=".CaptureActivity"
            android:exported="false" />

        <!-- Added by androidx.profileinstaller (a transitive dependency). The
             app ships no baseline profile and wants no exported receiver. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove"
            tools:ignore="MissingClass" />
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove"
            tools:ignore="MissingClass" />
    </application>

</manifest>
